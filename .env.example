# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.
# Never prefix them with VITE_ (that would expose them to the browser).

# Gemini API key from https://aistudio.google.com/apikey (needs billing for Veo / image models)
GEMINI_API_KEY=

# Your Firebase project id (same as "projectId" in firebase-applet-config.json)
FIREBASE_PROJECT_ID=dev-precinct-st3g1
